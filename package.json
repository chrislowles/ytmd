{
  "name": "ytmd",
  "version": "0.3.0",
  "description": "A simple Electron YouTube Music desktop client.",
  "repository": "chrislowles/ytmd",
  "main": "src/main.js",
  "desktopName": "com.chrislowles.ytmd.desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux flatpak"
  },
  "author": "chrislowles",
  "license": "Unlicense",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chrislowles.ytmd",
    "productName": "ytmd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/ytmd.svg"
    ],
    "linux": {
      "target": [
        "flatpak"
      ],
      "category": "AudioVideo",
      "icon": "build/ytmd.svg"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--own-name=org.mpris.MediaPlayer2.chromium.instance*"
      ]
    }
  }
}