{
  "name": "ytmd",
  "version": "0.1.0",
  "description": "A simple Electron YouTube Music desktop client.",
  "repository": "chrislowles/ytmd",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "chrislowles",
  "license": "Unlicense",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chrislowles.ytmd",
    "productName": "ytmd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/ytmd.svg"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "icon": "build/ytmd.svg"
    }
  }
}